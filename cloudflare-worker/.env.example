# Cloudflare Account ID
ACCOUNT_ID=your_account_id_here

# KV Namespace ID (get from: wrangler kv:namespace list)
KV_NAMESPACE_ID=your_kv_namespace_id

# Preview KV Namespace ID (for development)
PREVIEW_KV_NAMESPACE_ID=your_preview_kv_id

# Bot Configuration
BOT_NAME=June Ultra
BOT_PREFIX=!

# Webhook Secret (optional, for security)
WEBHOOK_SECRET=your_secret_key_here
